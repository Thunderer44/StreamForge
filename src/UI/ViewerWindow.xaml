<Window x:Class="ScreenShareApp.ViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="Stream Viewer" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen" 
        Background="{StaticResource DiscordDarkBg}"
        ui:WindowHelper.UseModernWindowStyle="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource DiscordDarkerBg}" 
                BorderBrush="{StaticResource DiscordDarkestBg}" BorderThickness="0,0,0,2"
                Padding="24,20">
            <Grid>
                <StackPanel>
                    <TextBlock Text="👁 Stream Viewer" FontSize="22" FontWeight="Bold" 
                               Foreground="White" Margin="0,0,0,16"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Server URL:" 
                                   Foreground="{StaticResource DiscordLightText}" 
                                   VerticalAlignment="Center" Margin="0,0,12,0" FontSize="14"/>
                        <TextBox x:Name="ServerUrlBox" Grid.Column="1" 
                                 Text="ws://localhost:8080" 
                                 Height="40" Padding="12" FontSize="14" 
                                 VerticalContentAlignment="Center"
                                 ui:ControlHelper.CornerRadius="4"/>
                        <Button x:Name="ConnectButton" Grid.Column="2" Content="🔗 Connect" 
                                Width="140" Height="40" Margin="12,0,0,0"
                                Click="ConnectButton_Click" 
                                Background="{StaticResource DiscordBlurple}" 
                                Foreground="White" BorderThickness="0" 
                                FontSize="14" FontWeight="SemiBold"
                                ui:ControlHelper.CornerRadius="4"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Stream Content -->
        <Grid Grid.Row="1" Margin="20">
            <Border Background="{StaticResource DiscordDarkerBg}" 
                    BorderBrush="{StaticResource DiscordDarkestBg}" 
                    BorderThickness="2" CornerRadius="8">
                <Grid>
                    <Image x:Name="StreamImage" Stretch="Uniform" Margin="4"/>
                    
                    <!-- Status Overlay -->
                    <Border Background="#CC2F3136" CornerRadius="8"
                            Visibility="Collapsed" x:Name="StatusOverlay">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="📡" FontSize="64" HorizontalAlignment="Center" 
                                       Margin="0,0,0,16" Opacity="0.6"/>
                            <TextBlock x:Name="StatusText" Text="Not connected" 
                                       Foreground="White" FontSize="20" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock x:Name="StatusSubText" 
                                       Text="Enter server URL and click Connect" 
                                       Foreground="{StaticResource DiscordMutedText}" 
                                       FontSize="14"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        
        <!-- Footer Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource DiscordDarkerBg}" 
                BorderBrush="{StaticResource DiscordDarkestBg}" BorderThickness="0,2,0,0"
                Padding="24,12">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusIndicator" Width="12" Height="12" 
                             Fill="{StaticResource DiscordGray}" 
                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="FooterStatusText" Text="Disconnected" 
                               FontSize="13" Foreground="{StaticResource DiscordLightText}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="StreamInfoText" Text="" 
                           FontSize="13" Foreground="{StaticResource DiscordMutedText}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
