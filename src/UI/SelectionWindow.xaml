<Window x:Class="ScreenShareApp.SelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScreenShareApp"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="Select what to share" Height="650" Width="900"
        WindowStartupLocation="CenterScreen" 
        Background="{StaticResource DiscordDarkBg}"
        ui:WindowHelper.UseModernWindowStyle="True">
    <Window.Resources>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <local:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter"/>
        
        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource DiscordGray}"/>
            <Setter Property="Foreground" Value="{StaticResource DiscordMutedText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ui:ControlHelper.CornerRadius" Value="4"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Margin="24,24,24,16">
            <TextBlock Text="Select what to share" FontSize="24" FontWeight="Bold" 
                       Foreground="White" Margin="0,0,0,8"/>
            <TextBlock Text="Choose a screen or window to stream" 
                       FontSize="14" Foreground="{StaticResource DiscordMutedText}"/>
        </StackPanel>
        
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="24,0,24,20">
            <Button x:Name="ScreensTab" Style="{StaticResource TabButtonStyle}"
                    Width="120" Height="40" Margin="0,0,8,0" 
                    Click="ScreensTab_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🖥" FontSize="16" Margin="0,0,8,0"/>
                    <TextBlock Text="Screens" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="WindowsTab" Style="{StaticResource TabButtonStyle}"
                    Width="120" Height="40" 
                    Click="WindowsTab_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🪟" FontSize="16" Margin="0,0,8,0"/>
                    <TextBlock Text="Windows" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
        
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="24,0,24,0">
            <ItemsControl x:Name="ItemsGrid">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="240" Height="180" Margin="8" 
                                Background="{StaticResource DiscordDarkerBg}" 
                                BorderBrush="{StaticResource DiscordDarkestBg}" 
                                BorderThickness="2" CornerRadius="8"
                                MouseLeftButtonDown="Item_Click" Cursor="Hand" 
                                Tag="{Binding Index}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource DiscordBlurple}"/>
                                            <Setter Property="BorderThickness" Value="3"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="{StaticResource DiscordGray}" 
                                        Margin="10,10,10,8" CornerRadius="6">
                                    <Grid>
                                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe UI Emoji" FontSize="56" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                   Foreground="{StaticResource DiscordLightText}"
                                                   Visibility="{Binding Preview, Converter={StaticResource NullToVisibilityConverter}}"/>
                                        <Image Source="{Binding Preview}" Stretch="Uniform" Margin="4"
                                               Visibility="{Binding Preview, Converter={StaticResource NotNullToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>
                                <TextBlock Grid.Row="1" Text="{Binding Name}" Foreground="White" 
                                           FontSize="14" FontWeight="Medium" Margin="12,0,12,12" 
                                           TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        
        <Border Grid.Row="3" Background="{StaticResource DiscordDarkerBg}" 
                BorderBrush="{StaticResource DiscordDarkestBg}" BorderThickness="0,2,0,0"
                Padding="24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="100" Height="42" Margin="0,0,12,0" 
                        Click="Cancel_Click" 
                        Background="{StaticResource DiscordGray}" 
                        Foreground="White" 
                        BorderThickness="0" FontSize="14" Cursor="Hand"
                        ui:ControlHelper.CornerRadius="4"/>
                <Button Content="📤 Share" Width="120" Height="42" 
                        Click="Share_Click" 
                        Background="{StaticResource DiscordBlurple}" 
                        Foreground="White" 
                        BorderThickness="0" FontSize="14" FontWeight="SemiBold" Cursor="Hand"
                        ui:ControlHelper.CornerRadius="4"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
